# Findly Search - Backend Environment Configuration

# Server Port (default: 5000)
PORT=5000

# Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Tavily Search API Key (Rekomendasi Utama)
# Dapatkan API Key gratis di: https://tavily.com/ (Pilih paket Free: 1.000 request/bulan)
# Masukkan API Key Anda di bawah ini:
TAVILY_API_KEY=your_tavily_api_key_here

# (Opsional) Brave Search API Key
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Maximum Download File Size in Megabytes (default: 20 MB)
MAX_DOWNLOAD_SIZE_MB=20
